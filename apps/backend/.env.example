# Environment Variables Example (No secrets!)
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Neon PostgreSQL Database
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# JWT & HMAC Signing Secret (REQUIRED in production: min 32 random chars, e.g. 64-char hex from `openssl rand -hex 32`)
AUTH_SECRET=
NEON_AUTH_BASE_URL=

# Email OTP & Password Reset via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="UBL LostnFound <noreply@lostandfound-budiluhur.web.id>"

# Cloudflare R2 Object Storage
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lostandfound-budiluhur
R2_PUBLIC_URL=
