{
  "name": "ubl-lostnfound-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "tsx ./node_modules/drizzle-kit/bin.cjs push",
    "db:generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "tsx ./node_modules/drizzle-kit/bin.cjs studio --port 4983",
    "r2:sync": "tsx src/scripts/sync-r2.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/cors": "^10.0.2",
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
